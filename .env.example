# Copy to .env and adjust before running `docker compose up` for anything beyond
# a quick local trial. Values here match the defaults baked into docker-compose.yml.

DB_NAME=expensetracker
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Must be overridden with your own random value for anything beyond local trial use
# (the fallback in docker-compose.yml is the same non-secret value committed in
# application.yml for local dev, and must not be relied on elsewhere).
JWT_SECRET=

SERVER_PORT=8085

# AI categorization is off by default because no Ollama container is bundled here.
# To enable it: install/run Ollama on the host, pull a model (e.g. `ollama pull llama3.1`),
# then set EXPENSE_AI_ENABLED=true below.
EXPENSE_AI_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
